<!-- //import layouts boilerplate.ejs -->
<% layout("/layouts/boilerplate") %>

    <section class="listings-page">
        <div class="page-header">
            <h3 class="page-title">Bookings on my turfs <span class="result-count"><%= bookings.length %></span></h3>
            <a class="btn-secondary" href="/bookings">My bookings</a>
        </div>

        <% if (bookings.length === 0) { %>
            <p class="no-reviews">Nobody has booked your turfs yet.</p>
        <% } %>

        <ul class="booking-list">
            <% for (let b of bookings) { %>
                <li class="booking-card <%= b.status === 'cancelled' ? 'booking-cancelled' : '' %>">
                    <div class="booking-main">
                        <h5 class="booking-turf">
                            <% if (b.turf) { %>
                                <a href="/listings/<%= b.turf._id %>"><%= b.turf.title %></a>
                            <% } else { %>
                                (turf removed)
                            <% } %>
                        </h5>
                        <p class="booking-when">
                            <i class="fa-solid fa-calendar"></i> <%= b.date %>
                            &nbsp;<i class="fa-solid fa-clock"></i> <%= minToLabel(b.startMin) %>&ndash;<%= minToLabel(b.endMin) %>
                        </p>
                        <p class="booking-where">
                            Booked by <strong><%= b.user ? b.user.username : "(deleted user)" %></strong>
                        </p>
                    </div>
                    <div class="booking-side">
                        <span class="booking-price">&#8377;<%= b.totalPrice.toLocaleString("en-IN") %></span>
                        <span class="booking-status status-<%= b.status %>"><%= b.status %></span>
                    </div>
                </li>
            <% } %>
        </ul>
    </section>
