
<!-- //import layouts boilerplate.ejs -->
<% layout("/layouts/boilerplate") %>

    <section class="form-page">
        <h3 class="page-title">Edit turf</h3>
        <form class="listing-form needs-validation" method="post" action="/listings/<%=listing._id %>?_method=PUT" enctype="multipart/form-data" novalidate>
            <label class="form-label">
                Turf name
                <input class="form-input" type="text" name="listing[title]" placeholder="Turf name" value="<%= listing.title %>" required>
            </label>
            <label class="form-label">
                Description
                <input class="form-input" type="text" name="listing[description]" placeholder="Description" value="<%= listing.description %>" required>
            </label>
            <label class="form-label">
                Price per hour (&#8377;)
                <input class="form-input" type="number" name="listing[price]" placeholder="Price" value="<%= listing.price %>" min="0" required>
            </label>
            <label class="form-label">
                Area
                <select class="form-input" name="listing[location]" required>
                    <% for (let a of areas) { %>
                        <option value="<%= a %>" <%= listing.location === a ? "selected" : "" %>><%= a %></option>
                    <% } %>
                </select>
            </label>
            <label class="form-label">
                Sport
                <select class="form-input" name="listing[category]" required>
                    <% for (let s of sports) { %>
                        <option value="<%= s.name %>" <%= listing.category === s.name ? "selected" : "" %>><%= s.name %></option>
                    <% } %>
                </select>
            </label>
            <label class="form-label">
                Surface
                <select class="form-input" name="listing[surface]">
                    <% for (let s of surfaces) { %>
                        <option value="<%= s %>" <%= listing.surface === s ? "selected" : "" %>><%= s %></option>
                    <% } %>
                </select>
            </label>
            <label class="form-label">
                Contact number
                <input class="form-input" type="tel" name="listing[phone]" placeholder="+91 90000 00000" value="<%= listing.phone || '' %>">
            </label>
            <div class="form-label">
                Amenities
                <div class="amenity-grid">
                    <% for (let a of amenities) { %>
                        <label class="amenity-item">
                            <input type="checkbox" name="listing[amenities]" value="<%= a %>" <%= (listing.amenities || []).includes(a) ? "checked" : "" %>>
                            <span><%= a %></span>
                        </label>
                    <% } %>
                </div>
            </div>
            <% if (listing.image && listing.image.url) { %>
                <img src="<%= listing.image.url %>" alt="Current turf photo" class="form-image-preview">
            <% } %>
            <label class="form-label">
                Replace turf photo
                <input class="form-input" type="file" name="listing[image]" accept="image/png,image/jpeg,image/webp">
            </label>
            <button class="btn-primary" type="submit">Update turf</button>
        </form>
    </section>
