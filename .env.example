# Copy this file to .env and fill in real values. .env itself is gitignored.

# Cloudinary - image uploads (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# MongoDB connection string, used by the app AND both seed scripts.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/turfhub?appName=Cluster0
# Local:  mongodb://127.0.0.1:27017/turfhub
# The database name goes between the "/" and the "?" - Atlas does not include it.
# Any of : / ? # [ ] @ inside the password must be percent-encoded (@ becomes %40).
ATLASDB_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/turfhub?appName=Cluster0

# Session secret - signs the session cookie, so anyone who knows it can forge a login.
# Generate your own with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET=generate_a_long_random_string

# Port. Optional locally (defaults to 3000). Hosts like Render set this themselves.
# NOTE: do not use 8080 on this machine - Oracle's TNSLSNR already binds 127.0.0.1:8080.
PORT=3000
